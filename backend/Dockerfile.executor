# CodeHive Multi-Language Execution Environment
# Supports: JavaScript (Node.js), Python 3, Java (OpenJDK)
# For ARM64 Mac compatibility

FROM amazoncorretto:17-alpine

# Install Node.js and Python
RUN apk add --no-cache \
    nodejs \
    npm \
    python3 \
    && adduser -D -u 1000 codeuser

# Set up workspace
WORKDIR /home/codeuser/workspace
RUN chown -R codeuser:codeuser /home/codeuser

USER codeuser

# Default shell
CMD ["/bin/sh"]
